{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "splitline-v1-app",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "v1/app", "run", "dev", "--", "--port", "5183"],
      "port": 5183
    },
    {
      "name": "spliteline",
      "runtimeExecutable": "cmd",
      "runtimeArgs": ["/c", "cd app && node node_modules/vite/bin/vite.js --port 5184 --strictPort"],
      "port": 5184
    },
    {
      "name": "spliteline-prod",
      "runtimeExecutable": "cmd",
      "runtimeArgs": ["/c", "cd app && node node_modules/vite/bin/vite.js preview --port 5185 --strictPort"],
      "port": 5185
    }
  ]
}
