# Copy to .env and fill in your own values. Never commit the real .env file.
# This key pays real mainnet gas (in USDC) when you deploy to arc_mainnet — use a
# dedicated deploy wallet, fund it with only as much as you need, and never reuse
# a key that holds anything else of value.
PRIVATE_KEY=

# Optional: override the public Arc RPC endpoints defined in foundry.toml.
# ARC_MAINNET_RPC_URL=https://rpc.mainnet.arc.io
# ARC_TESTNET_RPC_URL=https://rpc.testnet.arc.io
